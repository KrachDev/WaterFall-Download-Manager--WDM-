{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Waterfall",
  "version": "1.0.0",
  "identifier": "com.krachdev.waterfall",
  "build": {
    "frontendDist": "../src/frontend",
    "devUrl": "http://localhost:4567",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Waterfall — Modern IDM & JDownloader Suite",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
