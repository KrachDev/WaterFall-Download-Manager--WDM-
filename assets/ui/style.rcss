/* ==========================================================================
   Waterfall Download Accelerator - Obsidian Cyber-Fluid RCSS Design System
   ========================================================================== */

@font-face {
    font-family: "Segoe UI";
    src: "C:/Windows/Fonts/segoeui.ttf";
}

@font-face {
    font-family: "Segoe UI";
    src: "C:/Windows/Fonts/segoeuib.ttf";
    font-weight: bold;
}

@font-face {
    font-family: "Consolas";
    src: "C:/Windows/Fonts/consola.ttf";
}

body {
    font-family: "Segoe UI";
    font-size: 13px;
    background-color: #0b0f19;
    color: #e2e8f0;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* --------------------------------------------------------------------------
   Top Navigation & Command Toolbar
   -------------------------------------------------------------------------- */
#header {
    height: 52px;
    background-color: #111827;
    border-bottom: 2px solid #1f293d;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
}

.header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.logo-icon {
    font-size: 20px;
    margin-right: 8px;
}

.app-title {
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 1px;
}

.app-badge {
    font-size: 10px;
    font-weight: bold;
    background-color: #0284c7;
    color: #ffffff;
    padding: 3px 8px;
    margin-left: 10px;
    border-radius: 4px;
}

.header-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.tb-btn {
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #f1f5f9;
    font-size: 12px;
    font-weight: bold;
    padding: 7px 13px;
    margin-right: 6px;
    border-radius: 6px;
}

.tb-btn:hover {
    background-color: #334155;
    color: #00e5ff;
    border-color: #00e5ff;
}

.tb-btn.primary {
    background-color: #0284c7;
    border: 1px solid #38bdf8;
    color: #ffffff;
}

.tb-btn.primary:hover {
    background-color: #00e5ff;
    color: #000000;
}

.tb-btn.power {
    background-color: #1e293b;
    border-color: #f59e0b;
    color: #fbbf24;
}

.header-right {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.stat-pill {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 12px;
    margin-left: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-label {
    font-size: 9px;
    color: #94a3b8;
    font-weight: bold;
    letter-spacing: 0.5px;
}

.stat-value {
    font-size: 13px;
    font-weight: bold;
}

.stat-value.cyan { color: #00e5ff; }
.stat-value.emerald { color: #10b981; }

/* --------------------------------------------------------------------------
   Workspace Split-Layout
   -------------------------------------------------------------------------- */
#workspace {
    flex: 1;
    display: flex;
    flex-direction: row;
    overflow: hidden;
}

/* Sidebar */
#sidebar {
    width: 230px;
    background-color: #0f172a;
    border-right: 1px solid #1e293b;
    padding: 14px;
    display: flex;
    flex-direction: column;
}

.sidebar-section {
    margin-bottom: 16px;
}

.section-title {
    font-size: 10px;
    font-weight: bold;
    color: #64748b;
    letter-spacing: 1px;
    margin-bottom: 8px;
    display: block;
}

.sidebar-btn {
    display: block;
    width: 100%;
    background-color: transparent;
    border: none;
    color: #94a3b8;
    font-size: 12px;
    text-align: left;
    padding: 7px 10px;
    margin-bottom: 3px;
    border-radius: 5px;
}

.sidebar-btn:hover {
    background-color: #1e293b;
    color: #ffffff;
}

.sidebar-btn.active {
    background-color: #1e293b;
    color: #00e5ff;
    font-weight: bold;
    border-left: 3px solid #00e5ff;
}

.telemetry-box {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 10px;
    margin-top: auto;
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
}

.telemetry-title {
    font-size: 9px;
    color: #94a3b8;
    font-weight: bold;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
}

.telemetry-stat {
    font-size: 11px;
    color: #cbd5e1;
    margin-bottom: 3px;
}

.telemetry-stat.cyan { color: #00e5ff; font-weight: bold; }

.sidebar-footer {
    padding-top: 8px;
    border-top: 1px solid #1e293b;
}

.server-status {
    font-size: 10px;
    color: #10b981;
    font-weight: bold;
}

/* --------------------------------------------------------------------------
   Content Panels & Views
   -------------------------------------------------------------------------- */
#content {
    flex: 1;
    background-color: #0b0f19;
    padding: 16px 22px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

#downloads-view, #grabber-view, #media-view {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.tasks-list {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.view-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.view-title {
    font-size: 13px;
    font-weight: bold;
    color: #cbd5e1;
    letter-spacing: 1px;
}

.view-tools {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.search-input {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #ffffff;
    padding: 7px 12px;
    font-size: 12px;
    width: 280px;
    margin-right: 10px;
}

.tool-btn {
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #f1f5f9;
    font-size: 11px;
    font-weight: bold;
    padding: 6px 12px;
    border-radius: 5px;
    margin-left: 6px;
}

.tool-btn:hover {
    background-color: #334155;
    color: #ffffff;
}

.tool-btn.primary {
    background-color: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
}

.tool-btn.danger:hover {
    background-color: #dc2626;
    border-color: #ef4444;
}

.tasks-scroll-container {
    flex: 1;
    overflow-y: auto;
}

.empty-state-card {
    background-color: #111827;
    border: 1px dashed #334155;
    border-radius: 8px;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
}

.empty-title {
    font-size: 15px;
    font-weight: bold;
    color: #f8fafc;
    margin-bottom: 6px;
}

.empty-desc {
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 16px;
}

.empty-action {
    padding: 8px 18px;
    font-size: 12px;
}

/* --------------------------------------------------------------------------
   Download Task Cards
   -------------------------------------------------------------------------- */
.task-card {
    background-color: #111827;
    border: 1px solid #1f293d;
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 10px;
}

.task-card:hover {
    border-color: #00e5ff;
}

.card-top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.file-info {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.file-icon {
    font-size: 18px;
    margin-right: 10px;
}

.file-name {
    font-size: 13px;
    font-weight: bold;
    color: #ffffff;
}

.card-badges {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.badge-status {
    font-size: 10px;
    font-weight: bold;
    background-color: #1e293b;
    color: #38bdf8;
    padding: 3px 8px;
    border-radius: 4px;
    margin-right: 8px;
}

.badge-speed {
    font-size: 12px;
    font-weight: bold;
    color: #00e5ff;
}

.progress-track {
    height: 7px;
    background-color: #1e293b;
    border-radius: 4px;
    margin-bottom: 8px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: #00e5ff;
    border-radius: 4px;
}

.card-bottom {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.meta-stats {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.meta-text {
    font-size: 11px;
    color: #94a3b8;
}

.meta-dot {
    margin: 0 6px;
    color: #475569;
}

.card-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.btn-action {
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #cbd5e1;
    font-size: 11px;
    font-weight: bold;
    padding: 4px 10px;
    border-radius: 4px;
    margin-left: 6px;
}

.btn-action:hover {
    background-color: #334155;
    color: #ffffff;
}

.btn-action.inspect:hover {
    background-color: #0284c7;
    color: #ffffff;
}

.btn-action.danger:hover {
    background-color: #dc2626;
    border-color: #ef4444;
    color: #ffffff;
}

/* --------------------------------------------------------------------------
   LinkGrabber Package Cards
   -------------------------------------------------------------------------- */
.grabber-card {
    background-color: #111827;
    border: 1px solid #1f293d;
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 12px;
}

.grabber-card-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.pkg-icon {
    font-size: 20px;
    margin-right: 10px;
}

.pkg-name {
    font-size: 14px;
    font-weight: bold;
    color: #ffffff;
}

.pkg-hoster {
    font-size: 10px;
    font-weight: bold;
    background-color: #0369a1;
    color: #e0f2fe;
    padding: 3px 8px;
    border-radius: 4px;
    margin-left: 12px;
}

.grabber-card-body {
    display: flex;
    flex-direction: row;
    margin-bottom: 12px;
}

.pkg-meta {
    font-size: 12px;
    color: #94a3b8;
    margin-right: 20px;
}

.pkg-meta.emerald { color: #10b981; font-weight: bold; }

.grabber-card-footer {
    display: flex;
    flex-direction: row;
}

/* --------------------------------------------------------------------------
   Media & YouTube Studio View
   -------------------------------------------------------------------------- */
.media-container {
    display: flex;
    flex-direction: column;
}

.media-input-bar {
    display: flex;
    flex-direction: row;
    margin-bottom: 18px;
}

.media-url-input {
    flex: 1;
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #ffffff;
    padding: 9px 14px;
    font-size: 13px;
    margin-right: 12px;
}

.media-preview-card {
    background-color: #111827;
    border: 1px solid #1f293d;
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: row;
}

.media-thumb-box {
    width: 220px;
    height: 124px;
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.media-thumb-placeholder {
    font-size: 16px;
    font-weight: bold;
    color: #38bdf8;
}

.media-info-box {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.media-video-title {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 6px;
}

.media-video-author {
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 14px;
}

.format-label {
    font-size: 10px;
    font-weight: bold;
    color: #64748b;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
}

.format-chips {
    display: flex;
    flex-direction: row;
    margin-bottom: 16px;
}

.chip-btn {
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #cbd5e1;
    font-size: 11px;
    font-weight: bold;
    padding: 6px 12px;
    border-radius: 5px;
    margin-right: 8px;
}

.chip-btn.active {
    background-color: #0284c7;
    border-color: #00e5ff;
    color: #ffffff;
}

.btn-primary-large {
    background-color: #0284c7;
    border: 1px solid #38bdf8;
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    padding: 9px 18px;
    border-radius: 6px;
    width: 240px;
}

.btn-primary-large:hover {
    background-color: #00e5ff;
    color: #000000;
}

/* --------------------------------------------------------------------------
   Inspector Drawer
   -------------------------------------------------------------------------- */
#inspector-drawer {
    display: flex;
    width: 320px;
    background-color: #0f172a;
    border-left: 2px solid #1e293b;
    padding: 16px;
    flex-direction: column;
    overflow-y: auto;
}

.inspector-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 10px;
}

.inspector-title {
    font-size: 12px;
    font-weight: bold;
    color: #00e5ff;
    letter-spacing: 1px;
}

.btn-close {
    background-color: transparent;
    border: none;
    color: #94a3b8;
    font-size: 14px;
    font-weight: bold;
}

.btn-close:hover { color: #ffffff; }

.inspector-item {
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
}

.ins-label {
    font-size: 9px;
    font-weight: bold;
    color: #64748b;
    letter-spacing: 0.5px;
    margin-bottom: 3px;
}

.ins-val {
    font-size: 11px;
    color: #cbd5e1;
}

.ins-val.bold { font-weight: bold; color: #ffffff; }
.ins-val.monospace { font-family: "Consolas"; font-size: 10px; }
.ins-val.cyan { color: #00e5ff; }

.segment-grid-section {
    margin: 12px 0;
}

.segment-cells {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.seg-cell {
    width: 30px;
    height: 22px;
    font-size: 10px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    margin: 2px;
}

.seg-cell.done { background-color: #059669; color: #ffffff; }
.seg-cell.active { background-color: #00e5ff; color: #000000; }
.seg-cell.pending { background-color: #1e293b; color: #64748b; }

.priority-row {
    display: flex;
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 12px;
}

.priority-chip {
    flex: 1;
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #94a3b8;
    font-size: 11px;
    font-weight: bold;
    padding: 5px 0;
    text-align: center;
    border-radius: 4px;
    margin-right: 4px;
}

.priority-chip:hover {
    color: #ffffff;
}

.priority-chip.active {
    background-color: #0284c7;
    border-color: #00e5ff;
    color: #ffffff;
}

.inspector-actions {
    display: flex;
    flex-direction: column;
    margin-top: 14px;
    border-top: 1px solid #1e293b;
    padding-top: 12px;
}

.ins-action-btn {
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #cbd5e1;
    font-size: 11px;
    font-weight: bold;
    padding: 7px 10px;
    margin-bottom: 6px;
    border-radius: 5px;
    text-align: left;
}

.ins-action-btn:hover {
    background-color: #334155;
    color: #00e5ff;
    border-color: #00e5ff;
}

/* --------------------------------------------------------------------------
   Modal Overlays & Advanced Interactive Components
   -------------------------------------------------------------------------- */
.modal-backdrop {
    display: flex;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 8, 14, 0.90);
    align-items: center;
    justify-content: center;
}

.modal-backdrop.transparent {
    background-color: rgba(0, 0, 0, 0.55);
}

.modal-card {
    width: 520px;
    background-color: #111827;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
}

.modal-card.large {
    width: 740px;
    height: 500px;
}

.modal-card.small {
    width: 360px;
}

.modal-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 10px;
}

.modal-title {
    font-size: 14px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
}

.modal-body {
    display: flex;
    flex-direction: column;
}

.input-label {
    font-size: 10px;
    font-weight: bold;
    color: #64748b;
    letter-spacing: 0.5px;
    margin-top: 12px;
    margin-bottom: 6px;
}

.modal-input {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #ffffff;
    padding: 8px 12px;
    font-size: 12px;
}

.modal-input:focus { border-color: #00e5ff; }

.modal-textarea {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #ffffff;
    padding: 8px 12px;
    font-size: 12px;
    height: 110px;
}

.modal-subtabs {
    display: flex;
    flex-direction: row;
    border-bottom: 1px solid #1e293b;
    margin-bottom: 12px;
}

.subtab-btn {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #94a3b8;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 14px;
    cursor: pointer;
}

.subtab-btn.active {
    color: #00e5ff;
    border-bottom-color: #00e5ff;
}

.folder-picker-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.folder-picker-row .folder-input {
    flex: 1;
    margin-right: 8px;
}

.quick-folders-chips {
    display: flex;
    flex-direction: row;
    margin-top: 6px;
    margin-bottom: 10px;
}

.chip-folder-btn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #94a3b8;
    font-size: 10px;
    padding: 4px 8px;
    margin-right: 6px;
    cursor: pointer;
}

.chip-folder-btn:hover {
    color: #00e5ff;
    border-color: #00e5ff;
}

.engine-chips {
    display: flex;
    flex-direction: row;
    margin-top: 6px;
    margin-bottom: 12px;
}

.checkbox-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.checkbox-label {
    font-size: 12px;
    color: #cbd5e1;
    margin-left: 8px;
}

.modal-footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 20px;
    border-top: 1px solid #1e293b;
    padding-top: 14px;
}

/* Speed Limiter Quick Modal Styling */
.limiter-display {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 14px 18px;
    margin-top: 6px;
    margin-bottom: 14px;
}

.limiter-current-val {
    font-size: 20px;
    font-weight: bold;
    color: #00e5ff;
}

.limiter-status-tag {
    font-size: 10px;
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: #1e293b;
    color: #64748b;
}

.limiter-status-tag.active {
    background-color: #047857;
    color: #10b981;
}

.limiter-presets {
    display: flex;
    flex-direction: row;
    margin-bottom: 14px;
}

.preset-btn {
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: #cbd5e1;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: bold;
    margin-right: 6px;
    cursor: pointer;
}

.preset-btn:hover {
    border-color: #00e5ff;
    color: #ffffff;
    background-color: #0f172a;
}

.preset-btn.danger {
    border-color: #ef4444;
    color: #f87171;
}

.preset-btn.danger:hover {
    background-color: #ef4444;
    color: #ffffff;
}

.custom-limiter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.custom-limiter-row .modal-input {
    flex: 1;
    margin-right: 8px;
}

/* Batch Action Bar */
.batch-bar {
    background-color: #0c4a6e;
    border: 1px solid #0284c7;
    border-radius: 6px;
    padding: 8px 14px;
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.batch-text {
    font-size: 12px;
    font-weight: bold;
    color: #38bdf8;
    margin-right: 14px;
}

.card-select-btn {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background-color: #1e293b;
    border: 1px solid #475569;
    color: transparent;
    font-size: 12px;
    font-weight: bold;
    text-align: center;
    line-height: 20px;
    margin-right: 10px;
    padding: 0;
    cursor: pointer;
}

.card-select-btn:hover {
    border-color: #00e5ff;
}

.card-select-btn.checked {
    background-color: #0284c7;
    border-color: #38bdf8;
    color: #ffffff;
}

.menu-btn {
    font-size: 14px;
    font-weight: bold;
    padding: 4px 8px;
}

/* Context Menu Card */
.context-menu-card {
    width: 320px;
    background-color: #111827;
    border: 1px solid #38bdf8;
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
}

.context-header {
    border-bottom: 1px solid #1e293b;
    padding-bottom: 8px;
    margin-bottom: 8px;
}

.context-title {
    font-size: 12px;
    font-weight: bold;
    color: #ffffff;
    display: block;
}

.context-sub {
    font-size: 10px;
    color: #94a3b8;
    display: block;
    margin-top: 3px;
}

.context-items {
    display: flex;
    flex-direction: column;
}

.context-item {
    background-color: transparent;
    border: none;
    color: #cbd5e1;
    font-size: 11px;
    text-align: left;
    padding: 6px 10px;
    border-radius: 4px;
    cursor: pointer;
}

.context-item:hover {
    background-color: #1e293b;
    color: #38bdf8;
}

.context-item.danger {
    color: #f87171;
}

.context-item.danger:hover {
    background-color: #7f1d1d;
    color: #ffffff;
}

.context-divider {
    height: 1px;
    background-color: #1e293b;
    margin: 4px 0;
}

/* Password Vault List */
.vault-list {
    background-color: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 8px;
    max-height: 110px;
    display: flex;
    flex-direction: column;
    margin-top: 6px;
    margin-bottom: 8px;
}

.vault-item {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 6px;
    border-bottom: 1px solid #1e293b;
}

.vault-pwd {
    font-size: 11px;
    color: #e2e8f0;
}

.vault-del-btn {
    background-color: transparent;
    border: none;
    color: #f87171;
    font-size: 11px;
    cursor: pointer;
}

.stepper-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.stepper-val {
    font-size: 14px;
    font-weight: bold;
    color: #00e5ff;
    width: 40px;
    text-align: center;
}

.stepper-btn {
    width: 28px;
    height: 28px;
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
}

.stepper-btn:hover {
    border-color: #00e5ff;
    background-color: #334155;
}

/* Settings Layout */
.settings-layout {
    flex: 1;
    display: flex;
    flex-direction: row;
}

.settings-sidebar {
    width: 150px;
    border-right: 1px solid #1e293b;
    padding-right: 12px;
    display: flex;
    flex-direction: column;
}

.settings-tab-btn {
    background-color: transparent;
    border: none;
    color: #94a3b8;
    font-size: 12px;
    text-align: left;
    padding: 7px 10px;
    margin-bottom: 4px;
    border-radius: 5px;
}

.settings-tab-btn.active {
    background-color: #1e293b;
    color: #00e5ff;
    font-weight: bold;
}

.settings-panel {
    flex: 1;
    padding-left: 18px;
}

.setting-heading {
    font-size: 13px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 12px;
    display: block;
}

/* --------------------------------------------------------------------------
   Bottom Status Bar
   -------------------------------------------------------------------------- */
#statusbar {
    height: 26px;
    background-color: #0f172a;
    border-top: 1px solid #1e293b;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.status-item {
    font-size: 10px;
    color: #64748b;
    margin-right: 20px;
}

.status-item.right {
    margin-left: auto;
    color: #00e5ff;
    font-weight: bold;
}
