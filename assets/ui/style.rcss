/* ==========================================================================
   Waterfall Download Accelerator - Obsidian Cyber-Fluid RCSS Design System
   ========================================================================== */

body {
    font-family: "Segoe UI", sans-serif;
    background-color: #0b0f19;
    color: #e2e8f0;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* --------------------------------------------------------------------------
   Top Navigation & Telemetry Header
   -------------------------------------------------------------------------- */
#header {
    height: 56px;
    background-color: #111827;
    border-bottom: 1px solid #1f293d;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
}

.header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.logo-icon {
    font-size: 22px;
    margin-right: 8px;
}

.app-title {
    font-size: 16px;
    font-weight: bold;
    color: #f8fafc;
    letter-spacing: 1px;
}

.app-badge {
    font-size: 10px;
    font-weight: bold;
    background-color: #0369a1;
    color: #e0f2fe;
    padding: 2px 7px;
    margin-left: 10px;
    border-radius: 4px;
}

.header-center {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 500px;
}

.url-input {
    background-color: #0a0e17;
    border: 1px solid #24324a;
    border-radius: 6px;
    color: #f1f5f9;
    padding: 7px 12px;
    font-size: 12px;
    width: 380px;
    margin-right: 8px;
}

.url-input:focus {
    border: 1px solid #00e5ff;
}

.btn-primary {
    background-color: #0284c7;
    border: 1px solid #38bdf8;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    padding: 7px 14px;
    border-radius: 6px;
}

.btn-primary:hover {
    background-color: #00e5ff;
    color: #000000;
}

.header-right {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.stat-pill {
    background-color: #162032;
    border: 1px solid #24324a;
    border-radius: 6px;
    padding: 5px 12px;
    margin-left: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.stat-label {
    font-size: 9px;
    color: #94a3b8;
    font-weight: bold;
    letter-spacing: 0.5px;
}

.stat-value {
    font-size: 13px;
    font-weight: bold;
}

.stat-value.cyan {
    color: #00e5ff;
}

.stat-value.emerald {
    color: #10b981;
}

/* --------------------------------------------------------------------------
   Workspace Split-Layout
   -------------------------------------------------------------------------- */
#workspace {
    flex: 1;
    display: flex;
    flex-direction: row;
    overflow: hidden;
}

/* Sidebar */
#sidebar {
    width: 200px;
    background-color: #0e1422;
    border-right: 1px solid #1f293d;
    padding: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.sidebar-section {
    margin-bottom: 20px;
}

.section-title {
    font-size: 10px;
    font-weight: bold;
    color: #64748b;
    letter-spacing: 1px;
    margin-bottom: 8px;
    display: block;
}

.sidebar-btn {
    display: block;
    width: 100%;
    background-color: transparent;
    border: none;
    color: #94a3b8;
    font-size: 12px;
    text-align: left;
    padding: 7px 10px;
    margin-bottom: 4px;
    border-radius: 5px;
}

.sidebar-btn:hover {
    background-color: #172136;
    color: #f1f5f9;
}

.sidebar-btn.active {
    background-color: #1e2c47;
    color: #00e5ff;
    font-weight: bold;
}

.sidebar-footer {
    padding-top: 10px;
    border-top: 1px solid #1f293d;
}

.server-status {
    font-size: 10px;
    color: #10b981;
}

/* Content Area */
#content {
    flex: 1;
    background-color: #0b0f19;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.content-header {
    margin-bottom: 14px;
}

.feed-title {
    font-size: 11px;
    font-weight: bold;
    color: #64748b;
    letter-spacing: 1px;
}

.tasks-scroll-container {
    flex: 1;
    overflow-y: auto;
}

/* --------------------------------------------------------------------------
   Download Task Cards
   -------------------------------------------------------------------------- */
.task-card {
    background-color: #131b2c;
    border: 1px solid #202b3f;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 10px;
}

.task-card:hover {
    border: 1px solid #00e5ff;
}

.card-top {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.file-info {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.file-icon {
    font-size: 16px;
    margin-right: 8px;
}

.file-name {
    font-size: 13px;
    font-weight: bold;
    color: #f8fafc;
}

.card-badges {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.badge-status {
    font-size: 10px;
    background-color: #1e293b;
    color: #94a3b8;
    padding: 2px 7px;
    border-radius: 4px;
    margin-right: 6px;
}

.badge-speed {
    font-size: 11px;
    font-weight: bold;
    color: #00e5ff;
}

/* Progress Track & Fill */
.progress-track {
    height: 6px;
    background-color: #1c263a;
    border-radius: 3px;
    margin-bottom: 8px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: #00e5ff;
    border-radius: 3px;
}

/* Card Bottom & Actions */
.card-bottom {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.meta-stats {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.meta-text {
    font-size: 11px;
    color: #94a3b8;
}

.meta-dot {
    margin: 0 6px;
    color: #475569;
}

.card-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.btn-action {
    background-color: #1e293b;
    border: 1px solid #334155;
    color: #cbd5e1;
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 4px;
    margin-left: 6px;
}

.btn-action:hover {
    background-color: #334155;
    color: #ffffff;
}

.btn-action.danger:hover {
    background-color: #dc2626;
    border: 1px solid #ef4444;
    color: #ffffff;
}

/* --------------------------------------------------------------------------
   Bottom Status Bar
   -------------------------------------------------------------------------- */
#statusbar {
    height: 24px;
    background-color: #0d121d;
    border-top: 1px solid #1a2234;
    padding: 0 14px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.status-item {
    font-size: 10px;
    color: #64748b;
    margin-right: 18px;
}

.status-item.right {
    margin-left: auto;
    color: #00e5ff;
}
