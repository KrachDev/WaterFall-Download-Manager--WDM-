<rml>
<head>
    <title>Waterfall Download Accelerator</title>
    <link type="text/rcss" href="style.rcss"/>
</head>
<body data-model="downloads_model">

    <!-- Top Command Toolbar -->
    <div id="header">
        <div class="header-left">
            <span class="app-title">WATERFALL</span>
            <span class="app-badge">NATIVE C++20</span>
        </div>

        <!-- Central Action Command Buttons -->
        <div class="header-actions">
            <button class="tb-btn primary" data-event-click="open_add_modal()">+ Add Download</button>
            <button class="tb-btn" data-event-click="resume_all()">▶ Resume All</button>
            <button class="tb-btn" data-event-click="pause_all()">⏸ Pause All</button>
            <button class="tb-btn" data-event-click="clear_completed()">✕ Clear Done</button>
            <button class="tb-btn" data-event-click="open_limiter_modal()">⚡ Speed Cap</button>
            <button class="tb-btn" data-event-click="open_settings_modal()">⚙ Settings</button>
            <button class="tb-btn power" data-event-click="cycle_power_action()">Power: {{power_action}}</button>
        </div>

        <!-- Telemetry Stats Pill -->
        <div class="header-right">
            <div class="stat-pill">
                <span class="stat-label">TOTAL SPEED</span>
                <span class="stat-value cyan">{{total_speed}}</span>
            </div>
            <div class="stat-pill">
                <span class="stat-label">ACTIVE THREADS</span>
                <span class="stat-value emerald">{{active_count}} Active</span>
            </div>
        </div>
    </div>

    <!-- Main Application Split-Layout -->
    <div id="workspace">

        <!-- Sidebar Navigation Tree -->
        <div id="sidebar">
            <div class="sidebar-section">
                <span class="section-title">WORKSPACES</span>
                <button class="sidebar-btn" data-class-active="current_view == 'downloads'" data-event-click="set_view('downloads')">● Downloads ({{active_count}})</button>
                <button class="sidebar-btn" data-class-active="current_view == 'grabber'" data-event-click="set_view('grabber')">● LinkGrabber ({{grabber_count}})</button>
                <button class="sidebar-btn" data-class-active="current_view == 'media'" data-event-click="set_view('media')">● Media Studio</button>
            </div>

            <div class="sidebar-section">
                <span class="section-title">QUEUE STATUS</span>
                <button class="sidebar-btn" data-class-active="active_filter == 'all'" data-event-click="set_filter('all')">● All Downloads</button>
                <button class="sidebar-btn" data-class-active="active_filter == 'downloading'" data-event-click="set_filter('downloading')">▶ Active ({{active_count}})</button>
                <button class="sidebar-btn" data-class-active="active_filter == 'paused'" data-event-click="set_filter('paused')">⏸ Paused ({{paused_count}})</button>
                <button class="sidebar-btn" data-class-active="active_filter == 'completed'" data-event-click="set_filter('completed')">✓ Completed ({{completed_count}})</button>
            </div>

            <div class="sidebar-section">
                <span class="section-title">CATEGORIES</span>
                <button class="sidebar-btn" data-event-click="set_category('compressed')">■ Compressed Archives</button>
                <button class="sidebar-btn" data-event-click="set_category('videos')">■ Video Files</button>
                <button class="sidebar-btn" data-event-click="set_category('audio')">■ Audio &amp; Music</button>
                <button class="sidebar-btn" data-event-click="set_category('documents')">■ Documents</button>
                <button class="sidebar-btn" data-event-click="set_category('software')">■ Executables &amp; ISO</button>
            </div>

            <!-- Telemetry Monitor Box -->
            <div class="telemetry-box">
                <span class="telemetry-title">NETWORK TELEMETRY</span>
                <span class="telemetry-stat">Peak: 184.2 MB/s</span>
                <span class="telemetry-stat">Protocol: HTTP/2 TLS 1.3</span>
                <span class="telemetry-stat cyan">RAM: 11.4 MB (Native)</span>
            </div>

            <div class="sidebar-footer">
                <span class="server-status">● Extension: Port 4567 Connected</span>
            </div>
        </div>

        <!-- Central Content Area -->
        <div id="content">

            <!-- =============================================================== -->
            <!-- VIEW 1: ACTIVE DOWNLOADS QUEUE                                   -->
            <!-- =============================================================== -->
            <div id="downloads-view" data-if="current_view == 'downloads'">
                <div class="view-header">
                    <span class="view-title">DOWNLOAD QUEUE</span>
                    <div class="view-tools">
                        <button class="tool-btn" data-event-click="select_all_tasks()">Toggle All</button>
                        <button class="tool-btn" data-event-click="sort_queue('date')">Date</button>
                        <button class="tool-btn" data-event-click="sort_queue('name')">Name</button>
                        <button class="tool-btn" data-event-click="sort_queue('size')">Size</button>
                        <button class="tool-btn" data-event-click="clear_completed()">Clean Completed</button>
                    </div>
                </div>

                <!-- Multi-Selection Batch Action Bar -->
                <div class="batch-bar" data-if="selected_count > 0">
                    <span class="batch-text">{{selected_count}} Tasks Selected</span>
                    <button class="tool-btn primary" data-event-click="batch_resume()">▶ Resume</button>
                    <button class="tool-btn" data-event-click="batch_pause()">⏸ Pause</button>
                    <button class="tool-btn danger" data-event-click="batch_delete()">🗑 Delete</button>
                    <button class="tool-btn" data-event-click="batch_deselect()">✕ Cancel</button>
                </div>

                <div class="tasks-scroll-container">
                    <!-- Clean Empty-State When Queue is Empty -->
                    <div class="empty-state-card" data-if="!has_tasks">
                        <span class="empty-title">Queue is Empty</span>
                        <span class="empty-desc">Paste a download URL or click '+ Add Download' to start accelerating.</span>
                        <button class="tool-btn primary empty-action" data-event-click="open_add_modal()">+ Add Download Now</button>
                    </div>

                    <!-- Dynamic Task Cards Loop (Only shown when queue has items) -->
                    <div class="tasks-list" data-if="has_tasks">
                        <div data-for="task:tasks">
                            <div class="task-card">
                                <div class="card-top">
                                    <button class="card-select-btn" data-class-checked="task.selected" data-event-click="toggle_task_selection(task.id)">✓</button>
                                    <div class="file-info">
                                        <span class="file-name">{{task.filename}}</span>
                                    </div>
                                    <div class="card-badges">
                                        <span class="badge-status">{{task.status}}</span>
                                        <span class="badge-speed">{{task.speed}}</span>
                                    </div>
                                </div>

                                <!-- Progress Bar Track -->
                                <div class="progress-track">
                                    <div class="progress-fill" data-style-width="task.progress + '%'"></div>
                                </div>

                                <div class="card-bottom">
                                    <div class="meta-stats">
                                        <span class="meta-text">{{task.downloaded}} / {{task.total}}</span>
                                        <span class="meta-dot">•</span>
                                        <span class="meta-text">ETA: {{task.eta}}</span>
                                        <span class="meta-dot">•</span>
                                        <span class="meta-text">16 In-Place Sockets</span>
                                    </div>
                                    <div class="card-actions">
                                        <button class="btn-action" data-event-click="resume_download(task.id)">Resume</button>
                                        <button class="btn-action" data-event-click="pause_download(task.id)">Pause</button>
                                        <button class="btn-action" data-event-click="open_folder(task.id)">Folder</button>
                                        <button class="btn-action" data-if="task.category_id == 1" data-event-click="open_extracted(task.id)">📦 Extracted</button>
                                        <button class="btn-action inspect" data-event-click="toggle_inspector(task.id)">Inspect</button>
                                        <button class="btn-action menu-btn" data-event-click="open_task_menu(task.id)">⋮ Menu</button>
                                        <button class="btn-action danger" data-event-click="delete_download(task.id)">Delete</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =============================================================== -->
            <!-- VIEW 2: LINKGRABBER WORKSPACE                                   -->
            <!-- =============================================================== -->
            <div id="grabber-view" data-if="current_view == 'grabber'">
                <div class="view-header">
                    <span class="view-title">LINKGRABBER BATCH CRAWLER</span>
                    <div class="view-tools">
                        <button class="tool-btn primary" data-event-click="open_add_modal()">+ Add Links</button>
                        <button class="tool-btn" data-event-click="grabber_crawl()">Deep Crawl</button>
                        <button class="tool-btn" data-event-click="grabber_transfer_all()">▶ Transfer All</button>
                        <button class="tool-btn danger" data-event-click="grabber_clear()">✕ Clear Staged</button>
                    </div>
                </div>

                <div class="tasks-scroll-container">
                    <div class="empty-state-card" data-if="!has_grabber">
                        <span class="empty-title">LinkGrabber is Empty</span>
                        <span class="empty-desc">Copy links to clipboard and click 'Deep Crawl' or click '+ Add Links'.</span>
                        <button class="tool-btn primary empty-action" data-event-click="grabber_crawl()">Deep Crawl Clipboard</button>
                    </div>

                    <div class="tasks-list" data-if="has_grabber">
                        <div class="grabber-card" data-for="pkg:grabber_packages">
                            <div class="grabber-card-header">
                                <span class="pkg-name">{{pkg.name}}</span>
                                <span class="pkg-hoster">{{pkg.hoster}}</span>
                            </div>
                            <div class="grabber-card-body">
                                <span class="pkg-meta">Files: {{pkg.file_count}} Items</span>
                                <span class="pkg-meta">Total Size: {{pkg.total_size}}</span>
                                <span class="pkg-meta emerald">Status: {{pkg.status}}</span>
                            </div>
                            <div class="grabber-card-footer">
                                <button class="btn-action primary" data-event-click="grabber_add_package(pkg.id)">⚡ Transfer to Downloads</button>
                                <button class="btn-action danger" data-event-click="grabber_clear()">Remove Package</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- =============================================================== -->
            <!-- VIEW 3: MEDIA & YOUTUBE STUDIO                                  -->
            <!-- =============================================================== -->
            <div id="media-view" data-if="current_view == 'media'">
                <div class="view-header">
                    <span class="view-title">YOUTUBE &amp; MEDIA STUDIO</span>
                </div>

                <div class="media-container">
                    <div class="media-input-bar">
                        <input type="text" class="media-url-input" data-value="media_url" placeholder="Paste YouTube, Vimeo, or Stream URL..."/>
                        <button class="tool-btn primary" data-event-click="media_probe()">Probe Formats</button>
                    </div>

                    <!-- Media Preview Card -->
                    <div class="media-preview-card">
                        <div class="media-thumb-box">
                            <span class="media-thumb-placeholder">4K HDR</span>
                        </div>
                        <div class="media-info-box">
                            <span class="media-video-title">{{media_title}}</span>
                            <span class="media-video-author">Channel: {{media_author}} • Duration: {{media_duration}}</span>

                            <span class="format-label">SELECT EXTRACTION FORMAT:</span>
                            <div class="format-chips">
                                <button class="chip-btn" data-class-active="media_format == 'mp4-best'" data-event-click="set_media_format('mp4-best')">4K Video (2160p HDR)</button>
                                <button class="chip-btn" data-class-active="media_format == 'mp4-1080'" data-event-click="set_media_format('mp4-1080')">1080p Full HD</button>
                                <button class="chip-btn" data-class-active="media_format == 'mp3-320'" data-event-click="set_media_format('mp3-320')">MP3 Audio (320kbps)</button>
                                <button class="chip-btn" data-class-active="media_format == 'flac'" data-event-click="set_media_format('flac')">FLAC Lossless</button>
                            </div>

                            <button class="btn-primary-large" data-event-click="media_download()">⚡ Download Media Stream</button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- =================================================================== -->
        <!-- =================================================================== -->
        <!-- SLIDE-OUT TASK INSPECTOR DRAWER                                     -->
        <!-- =================================================================== -->
        <div id="inspector-drawer" data-if="is_inspector_open">
            <div class="inspector-header">
                <span class="inspector-title">TASK INSPECTOR</span>
                <button class="btn-close" data-event-click="close_inspector()">✕</button>
            </div>
            <div class="inspector-body">
                <div class="inspector-item">
                    <span class="ins-label">FILENAME</span>
                    <span class="ins-val bold">{{inspector_filename}}</span>
                </div>
                <div class="inspector-item">
                    <span class="ins-label">STATUS &amp; SPEED</span>
                    <span class="ins-val cyan bold">{{inspector_status}} • {{inspector_speed}}</span>
                </div>
                <div class="inspector-item">
                    <span class="ins-label">DOWNLOAD PROGRESS</span>
                    <span class="ins-val">{{inspector_progress_text}}</span>
                </div>
                <div class="inspector-item">
                    <span class="ins-label">ESTIMATED TIME REMAINING</span>
                    <span class="ins-val">{{inspector_eta}}</span>
                </div>
                <div class="inspector-item">
                    <span class="ins-label">ORIGIN URL</span>
                    <span class="ins-val monospace">{{inspector_url}}</span>
                </div>
                <div class="inspector-item">
                    <span class="ins-label">DISK DESTINATION</span>
                    <span class="ins-val monospace">{{inspector_path}}</span>
                </div>
                <div class="inspector-item">
                    <span class="ins-label">CHECKSUM (SHA-256)</span>
                    <span class="ins-val cyan monospace">{{inspector_hash}}</span>
                </div>

                <!-- Live Multi-Socket Segment Visualizer Grid -->
                <div class="segment-grid-section">
                    <span class="ins-label">MULTI-SOCKET STREAM SEGMENT MAP</span>
                    <div class="segment-cells">
                        <div data-for="chunk:inspector_chunks_list">
                            <div class="seg-cell" data-class-done="chunk.state == 'done'" data-class-active="chunk.state == 'active'" data-class-pending="chunk.state == 'pending'">{{chunk.text}}</div>
                        </div>
                    </div>
                </div>

                <!-- Priority Selector -->
                <div class="inspector-item">
                    <span class="ins-label">QUEUE PRIORITY</span>
                    <div class="priority-row">
                        <button class="priority-chip" data-class-active="inspector_priority == 'Low'" data-event-click="inspector_set_priority(1)">Low</button>
                        <button class="priority-chip" data-class-active="inspector_priority == 'Normal'" data-event-click="inspector_set_priority(2)">Normal</button>
                        <button class="priority-chip" data-class-active="inspector_priority == 'High'" data-event-click="inspector_set_priority(3)">High</button>
                    </div>
                </div>

                <!-- Inspector Quick Actions -->
                <div class="inspector-actions">
                    <button class="ins-action-btn" data-event-click="inspector_open_file()">▶ Open File</button>
                    <button class="ins-action-btn" data-event-click="inspector_open_folder()">📁 Open Containing Folder</button>
                    <button class="ins-action-btn" data-event-click="inspector_verify_hash()">🔒 Recompute SHA-256 Hash</button>
                    <button class="ins-action-btn" data-event-click="inspector_copy_link()">📋 Copy Download Link</button>
                    <button class="ins-action-btn" data-event-click="inspector_extract_now()">⚡ Extract Archive Now</button>
                </div>
            </div>
        </div>

    </div>

    <!-- ======================================================================= -->
    <!-- MODAL 1: ADD DOWNLOAD OVERLAY                                           -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" data-if="is_add_modal_open">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title">ADD NEW DOWNLOAD</span>
                <button class="btn-close" data-event-click="close_add_modal()">✕</button>
            </div>
            <div class="modal-body">
                <!-- Sub-Tabs: Direct / Batch / Media -->
                <div class="modal-subtabs">
                    <button class="subtab-btn" data-class-active="add_modal_tab == 'direct'" data-event-click="set_add_modal_tab('direct')">Direct URL</button>
                    <button class="subtab-btn" data-class-active="add_modal_tab == 'batch'" data-event-click="set_add_modal_tab('batch')">Batch URLs</button>
                    <button class="subtab-btn" data-class-active="add_modal_tab == 'media'" data-event-click="set_add_modal_tab('media')">YouTube / Media</button>
                </div>

                <div data-if="add_modal_tab == 'direct'">
                    <span class="input-label">ORIGIN DOWNLOAD URL</span>
                    <input type="text" class="modal-input" placeholder="https://... (HTTP, HTTPS, Direct Link)" data-value="new_url"/>

                    <span class="input-label">CUSTOM FILENAME (OPTIONAL)</span>
                    <input type="text" class="modal-input" placeholder="Leave empty for auto-detection" data-value="new_custom_name"/>

                    <span class="input-label">DOWNLOAD DESTINATION FOLDER</span>
                    <div class="folder-picker-row">
                        <input type="text" class="modal-input folder-input" data-value="new_save_folder"/>
                        <button class="tb-btn" data-event-click="browse_add_folder()">Browse...</button>
                    </div>

                    <div class="quick-folders-chips">
                        <button class="chip-folder-btn" data-event-click="set_quick_folder('downloads')">Downloads</button>
                        <button class="chip-folder-btn" data-event-click="set_quick_folder('desktop')">Desktop</button>
                        <button class="chip-folder-btn" data-event-click="set_quick_folder('videos')">Videos</button>
                        <button class="chip-folder-btn" data-event-click="set_quick_folder('music')">Music</button>
                    </div>

                    <span class="input-label">DOWNLOAD ACCELERATION ENGINE</span>
                    <div class="engine-chips">
                        <button class="chip-btn" data-class-active="new_engine_mode == 'inPlace-16'" data-event-click="set_engine_mode('inPlace-16')">⚡ 16 Sockets In-Place</button>
                        <button class="chip-btn" data-class-active="new_engine_mode == 'inPlace-32'" data-event-click="set_engine_mode('inPlace-32')">⚡ 32 Sockets Turbo</button>
                        <button class="chip-btn" data-class-active="new_engine_mode == 'singleStream'" data-event-click="set_engine_mode('singleStream')">● Single Stream</button>
                    </div>

                    <span class="input-label">ARCHIVE PASSWORD (IF ENCRYPTED)</span>
                    <input type="text" class="modal-input" placeholder="Optional archive extraction password" data-value="new_archive_password"/>
                </div>

                <div data-if="add_modal_tab == 'batch'">
                    <span class="input-label">BATCH URLS (ONE PER LINE)</span>
                    <textarea class="modal-textarea" rows="6" placeholder="https://example.com/file1.zip&#10;https://example.com/file2.rar" data-value="new_batch_urls"></textarea>

                    <span class="input-label">SAVE DESTINATION FOLDER</span>
                    <div class="folder-picker-row">
                        <input type="text" class="modal-input folder-input" data-value="new_save_folder"/>
                        <button class="tb-btn" data-event-click="browse_add_folder()">Browse...</button>
                    </div>
                </div>

                <div data-if="add_modal_tab == 'media'">
                    <span class="input-label">YOUTUBE / VIDEO URL</span>
                    <input type="text" class="modal-input" placeholder="https://www.youtube.com/watch?v=..." data-value="media_url"/>
                    <span class="input-label">OUTPUT FORMAT</span>
                    <div class="engine-chips">
                        <button class="chip-btn" data-class-active="media_format == 'mp4-1080'" data-event-click="set_media_format('mp4-1080')">1080p MP4 Video</button>
                        <button class="chip-btn" data-class-active="media_format == 'mp4-best'" data-event-click="set_media_format('mp4-best')">4K Best Video</button>
                        <button class="chip-btn" data-class-active="media_format == 'mp3-320'" data-event-click="set_media_format('mp3-320')">320k MP3 Audio</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="tb-btn" data-event-click="close_add_modal()">Cancel</button>
                <button class="tb-btn primary" data-event-click="submit_add_modal()">⚡ Start Download</button>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- MODAL 2: SETTINGS OVERLAY                                               -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" data-if="is_settings_modal_open">
        <div class="modal-card large">
            <div class="modal-header">
                <span class="modal-title">APPLICATION SETTINGS</span>
                <button class="btn-close" data-event-click="close_settings_modal()">✕</button>
            </div>
            <div class="modal-body settings-layout">
                <!-- Settings Left Tabs -->
                <div class="settings-sidebar">
                    <button class="settings-tab-btn" data-class-active="settings_tab == 'general'" data-event-click="set_settings_tab('general')">General</button>
                    <button class="settings-tab-btn" data-class-active="settings_tab == 'engine'" data-event-click="set_settings_tab('engine')">Chunk Engine</button>
                    <button class="settings-tab-btn" data-class-active="settings_tab == 'limiter'" data-event-click="set_settings_tab('limiter')">Speed Limiter</button>
                    <button class="settings-tab-btn" data-class-active="settings_tab == 'archive'" data-event-click="set_settings_tab('archive')">Decompression</button>
                    <button class="settings-tab-btn" data-class-active="settings_tab == 'automation'" data-event-click="set_settings_tab('automation')">Automation</button>
                </div>

                <!-- Settings Tab Content -->
                <div class="settings-panel">
                    <div data-if="settings_tab == 'general'">
                        <span class="setting-heading">General Configuration</span>
                        <span class="input-label">DEFAULT STORAGE LOCATION</span>
                        <div class="folder-picker-row">
                            <input type="text" class="modal-input folder-input" data-value="settings_save_path"/>
                            <button class="tb-btn" data-event-click="browse_settings_folder()">Browse...</button>
                        </div>

                        <span class="input-label">MAX CONCURRENT DOWNLOADS</span>
                        <div class="stepper-row">
                            <button class="stepper-btn" data-event-click="settings_change_max_concurrent(-1)">-</button>
                            <span class="stepper-val">{{settings_max_concurrent}}</span>
                            <button class="stepper-btn" data-event-click="settings_change_max_concurrent(1)">+</button>
                        </div>

                        <span class="input-label">MAX CONCURRENT PER HOST</span>
                        <div class="stepper-row">
                            <button class="stepper-btn" data-event-click="settings_change_max_per_host(-1)">-</button>
                            <span class="stepper-val">{{settings_max_per_host}}</span>
                            <button class="stepper-btn" data-event-click="settings_change_max_per_host(1)">+</button>
                        </div>
                    </div>

                    <div data-if="settings_tab == 'engine'">
                        <span class="setting-heading">Native Network &amp; Disk Engine</span>
                        <span class="input-label">DEFAULT THREADS PER TASK</span>
                        <input type="text" class="modal-input" data-value="settings_default_connections"/>
                        <span class="input-label">STREAM DISK BUFFER SIZE</span>
                        <input type="text" class="modal-input" value="64 KB"/>
                    </div>

                    <div data-if="settings_tab == 'limiter'">
                        <span class="setting-heading">Global Speed Limiter</span>
                        <span class="input-label">CURRENT SPEED CAP</span>
                        <input type="text" class="modal-input" data-value="limiter_display_text"/>
                        <button class="tb-btn primary" style="margin-top: 10px;" data-event-click="open_limiter_modal()">Configure Speed Limiter...</button>
                    </div>

                    <div data-if="settings_tab == 'archive'">
                        <span class="setting-heading">Multi-Part Archive Extractor &amp; Password Vault</span>
                        <div class="checkbox-row">
                            <input type="checkbox" checked="checked"/>
                            <span class="checkbox-label">Automatically extract archives when all parts finish</span>
                        </div>
                        <span class="input-label">SAVED ARCHIVE PASSWORDS</span>
                        <div class="vault-list">
                            <div class="vault-item" data-for="pwd:vault_passwords">
                                <span class="vault-pwd">{{pwd}}</span>
                                <button class="vault-del-btn" data-event-click="remove_vault_password(pwd)">✕</button>
                            </div>
                        </div>
                        <div class="folder-picker-row">
                            <input type="text" class="modal-input folder-input" placeholder="Add new password to vault..." data-value="new_vault_password"/>
                            <button class="tb-btn primary" data-event-click="add_vault_password()">+ Add</button>
                        </div>
                    </div>

                    <div data-if="settings_tab == 'automation'">
                        <span class="setting-heading">Post-Download Automation</span>
                        <span class="input-label">CUSTOM POST-PROCESSING SCRIPT PATH</span>
                        <input type="text" class="modal-input" placeholder="C:\scripts\post_download.bat" data-value="settings_script_path"/>
                        <div class="checkbox-row">
                            <input type="checkbox"/>
                            <span class="checkbox-label">Run script upon download completion</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="tb-btn" data-event-click="close_settings_modal()">Close</button>
                <button class="tb-btn primary" data-event-click="save_settings_modal()">💾 Save Changes</button>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- MODAL 3: SPEED LIMITER QUICK MODAL                                      -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" data-if="is_limiter_modal_open">
        <div class="modal-card">
            <div class="modal-header">
                <span class="modal-title">⚡ GLOBAL SPEED LIMITER</span>
                <button class="btn-close" data-event-click="close_limiter_modal()">✕</button>
            </div>
            <div class="modal-body">
                <span class="input-label">CURRENT BANDWIDTH STATUS</span>
                <div class="limiter-display">
                    <span class="limiter-current-val">{{limiter_display_text}}</span>
                    <span class="limiter-status-tag" data-class-active="limiter_enabled">{{limiter_status_text}}</span>
                </div>

                <span class="input-label">QUICK PRESETS</span>
                <div class="limiter-presets">
                    <button class="preset-btn" data-event-click="set_speed_preset('500k')">500 KB/s</button>
                    <button class="preset-btn" data-event-click="set_speed_preset('1m')">1 MB/s</button>
                    <button class="preset-btn" data-event-click="set_speed_preset('5m')">5 MB/s</button>
                    <button class="preset-btn" data-event-click="set_speed_preset('10m')">10 MB/s</button>
                    <button class="preset-btn" data-event-click="set_speed_preset('20m')">20 MB/s</button>
                    <button class="preset-btn danger" data-event-click="set_speed_preset('unlimited')">● Unlimited</button>
                </div>

                <span class="input-label">CUSTOM CAP (MB/s)</span>
                <div class="custom-limiter-row">
                    <input type="text" class="modal-input" placeholder="e.g. 12.5" data-value="limiter_custom_input"/>
                    <button class="tb-btn primary" data-event-click="apply_custom_limit()">Apply</button>
                </div>
            </div>
            <div class="modal-footer">
                <button class="tb-btn" data-event-click="toggle_speed_limit()">Toggle Limiter</button>
                <button class="tb-btn primary" data-event-click="close_limiter_modal()">Done</button>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- MODAL 4: TASK CONTEXT MENU MODAL OVERLAY                                -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop transparent" data-if="is_context_menu_open">
        <div class="context-menu-card">
            <div class="context-header">
                <span class="context-title">{{context_task_filename}}</span>
                <span class="context-sub">{{context_task_info}}</span>
            </div>
            <div class="context-items">
                <button class="context-item" data-event-click="context_open_file()">▶ Open File</button>
                <button class="context-item" data-event-click="context_open_folder()">📁 Open Containing Folder</button>
                <button class="context-item" data-event-click="context_open_extracted()">📦 Open Extracted Folder</button>
                <button class="context-item" data-event-click="context_extract_now()">⚡ Extract Archive Now</button>
                <button class="context-item" data-event-click="context_verify_hash()">🔒 Verify SHA-256 Checksum</button>
                <button class="context-item" data-event-click="context_copy_link()">📋 Copy Download Link</button>
                <div class="context-divider"></div>
                <button class="context-item" data-event-click="context_move_top()">⬆ Move to Top</button>
                <button class="context-item" data-event-click="context_move_up()">▲ Move Up</button>
                <button class="context-item" data-event-click="context_move_down()">▼ Move Down</button>
                <button class="context-item" data-event-click="context_move_bottom()">⬇ Move to Bottom</button>
                <div class="context-divider"></div>
                <button class="context-item danger" data-event-click="context_delete_list()">✕ Delete from List Only</button>
                <button class="context-item danger" data-event-click="context_delete_disk()">🗑 Delete from List &amp; Disk</button>
            </div>
            <div class="modal-footer" style="margin-top: 10px; padding-top: 8px;">
                <button class="tb-btn" data-event-click="close_context_menu()">Close</button>
            </div>
        </div>
    </div>

    <!-- ======================================================================= -->
    <!-- MODAL 5: ARCHIVE PASSWORD REQUIRED MODAL                                -->
    <!-- ======================================================================= -->
    <div class="modal-backdrop" data-if="is_password_modal_open">
        <div class="modal-card small">
            <div class="modal-header">
                <span class="modal-title">🔐 ARCHIVE PASSWORD REQUIRED</span>
                <button class="btn-close" data-event-click="close_password_modal()">✕</button>
            </div>
            <div class="modal-body">
                <span class="input-label">ARCHIVE FILE</span>
                <span class="ins-val bold" style="margin-bottom: 12px;">{{password_modal_filename}}</span>

                <span class="input-label">ENTER DECRYPTION PASSWORD</span>
                <input type="text" class="modal-input" placeholder="Archive password..." data-value="password_modal_input"/>

                <div class="checkbox-row" style="margin-top: 10px;">
                    <input type="checkbox" checked="checked"/>
                    <span class="checkbox-label">Remember password in Vault for future archives</span>
                </div>
            </div>
            <div class="modal-footer">
                <button class="tb-btn" data-event-click="close_password_modal()">Cancel</button>
                <button class="tb-btn primary" data-event-click="submit_archive_password()">⚡ Extract Archive</button>
            </div>
        </div>
    </div>

    <!-- Bottom Status Strip -->
    <div id="statusbar">
        <span class="status-item">Engine: Zero-Copy WinHTTP IOCP Pipeline</span>
        <span class="status-item">Storage: SQLite3 WAL Mode</span>
        <span class="status-item right">Memory: 100% Native C++ (Zero Web Engine)</span>
    </div>

</body>
</rml>
